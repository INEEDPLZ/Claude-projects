#!/usr/bin/env bash
# Detect GPUs and install the right drivers. Used by the installer; safe to rerun.
#   zorp-gpu-setup            detect + install
#   zorp-gpu-setup --dry-run  print what would be installed
#   zorp-gpu-setup --root /mnt   install into a mounted target (installer)
set -euo pipefail
dry=0 root=/
while (( $# )); do case $1 in --dry-run) dry=1;; --root) root=$2; shift;; *) echo "unknown arg $1"; exit 2;; esac; shift; done

# display controllers: "0000:01:00.0 0300: 10de:2684 (rev a1)" -> vendor 10de, device 2684
mapfile -t gpus < <(lspci -Dn | awk '$2 ~ /^03/ {print $3}')
pkgs=(mesa lib32-mesa vulkan-icd-loader lib32-vulkan-icd-loader)
nv=0 other=0 notes=()
for id in "${gpus[@]}"; do
  vid=${id%%:*} devid=${id##*:}
  case $vid in
    1002) other=1; pkgs+=(vulkan-radeon lib32-vulkan-radeon libva-mesa-driver) ;;
    8086) other=1; pkgs+=(vulkan-intel lib32-vulkan-intel intel-media-driver) ;;
    10de)
      if (( 16#$devid >= 16#1e00 )); then   # Turing (RTX 20 / GTX 16) and newer
        nv=1; pkgs+=(nvidia-open-dkms nvidia-utils lib32-nvidia-utils nvidia-settings)
      else
        notes+=("NVIDIA $devid predates Turing: nvidia-open can't drive it; keeping nouveau.")
        pkgs+=(vulkan-nouveau lib32-vulkan-nouveau)
      fi ;;
    *) other=1 ;;
  esac
done
(( nv && other )) && pkgs+=(nvidia-prime switcheroo-control) && notes+=("Hybrid graphics: launch games with 'prime-run %command%'.")
(( nv )) && pkgs+=(linux-zen-headers linux-lts-headers)

mapfile -t pkgs < <(printf '%s\n' "${pkgs[@]}" | awk '!seen[$0]++')
echo "GPU(s):"; lspci | awk '/VGA|3D|Display/' | sed 's/^/  /'
echo "Driver packages: ${pkgs[*]}"
for n in "${notes[@]}"; do echo "note: $n"; done
(( dry )) && exit 0
# -y: fresh installs have no sync databases (archiso strips them)
if [[ $root == / ]]; then pacman -Sy --needed --noconfirm "${pkgs[@]}"
else arch-chroot "$root" pacman -Sy --needed --noconfirm "${pkgs[@]}"; fi
(( nv )) && systemctl --root="$root" enable nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service 2>/dev/null || true
echo "GPU drivers ready."

#!/usr/bin/env bash
# zorp-install-cli: scriptable ZorpOS install (the graphical one is "Abduction Sequence" / Calamares).
#
#   sudo zorp-install-cli --disk /dev/nvme0n1 --user zorp --password 'secret' \
#        [--hostname mothership] [--timezone UTC] [--locale en_US.UTF-8] [--keymap us] [--serial-console] --yes-wipe-disk
#
# WIPES THE WHOLE DISK. Layout: GPT. UEFI: 1 GiB ESP (FAT32, /boot) + ext4 root.
# BIOS: 1 MiB BIOS-boot partition + ext4 root (GRUB).
set -euo pipefail
DISK="" USER_NAME="" PASS="" HOST="mothership" TZ="UTC" LOCALE="en_US.UTF-8" KEYMAP="us" YES=0 SERIAL=0
while (($#)); do
  case $1 in
    --disk) DISK=$2; shift ;; --user) USER_NAME=$2; shift ;; --password) PASS=$2; shift ;;
    --hostname) HOST=$2; shift ;; --timezone) TZ=$2; shift ;; --locale) LOCALE=$2; shift ;;
    --keymap) KEYMAP=$2; shift ;; --yes-wipe-disk) YES=1 ;; --serial-console) SERIAL=1 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done
[[ $EUID -eq 0 ]] || { echo "run as root"; exit 1; }
[[ -b $DISK && -n $USER_NAME && -n $PASS ]] || { echo "need --disk, --user and --password (see --help)"; exit 2; }
[[ $USER_NAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || { echo "invalid user name"; exit 2; }
((YES)) || { echo "refusing to wipe $DISK without --yes-wipe-disk"; exit 2; }
SFS=$(ls /run/archiso/bootmnt/zorp/x86_64/airootfs.sfs 2>/dev/null || true)
[[ -n $SFS ]] || { echo "not running from the ZorpOS live medium (no airootfs.sfs)"; exit 1; }
log() { printf '\e[32m[abduction]\e[0m %s\n' "$*"; }
UEFI=0; [[ -d /sys/firmware/efi/efivars ]] && UEFI=1
part() { [[ $DISK =~ [0-9]$ ]] && echo "${DISK}p$1" || echo "${DISK}$1"; }
T=/mnt/zorp-target

log "partitioning $DISK ($( ((UEFI)) && echo UEFI || echo BIOS ))"
umount -R "$T" 2>/dev/null || true
wipefs -af "$DISK" >/dev/null
if ((UEFI)); then
  sgdisk -Z -n1:0:+1G -t1:ef00 -c1:ZORP_ESP -n2:0:0 -t2:8304 -c2:ZORP_ROOT "$DISK" >/dev/null
else
  sgdisk -Z -n1:0:+1M -t1:ef02 -c1:BIOSBOOT -n2:0:0 -t2:8304 -c2:ZORP_ROOT "$DISK" >/dev/null
fi
partprobe "$DISK" 2>/dev/null || true; udevadm settle
mkfs.ext4 -qF -L zorpos "$(part 2)"
((UEFI)) && mkfs.fat -F32 -n ZORP_ESP "$(part 1)" >/dev/null
udevadm settle
# explicit types: right after mkfs the probe can still see stale signatures
mkdir -p "$T"; mount -t ext4 "$(part 2)" "$T"
if ((UEFI)); then
  mkdir -p "$T/boot"; mount -t vfat "$(part 1)" "$T/boot"
fi

log "copying the specimen (live system) to disk"
unsquashfs -f -q -d "$T" "$SFS"
genfstab -U "$T" > "$T/etc/fstab"

log "identity: $HOST, $LOCALE, $TZ, keymap $KEYMAP"
echo "$HOST" > "$T/etc/hostname"
sed -i "s/^#\?\(${LOCALE//./\\.} \)/\1/" "$T/etc/locale.gen"
echo "LANG=$LOCALE" > "$T/etc/locale.conf"
sed -i "s/^KEYMAP=.*/KEYMAP=$KEYMAP/" "$T/etc/vconsole.conf"
arch-chroot "$T" locale-gen >/dev/null
ln -sf "/usr/share/zoneinfo/$TZ" "$T/etc/localtime"
arch-chroot "$T" systemd-machine-id-setup >/dev/null

log "creating $USER_NAME (wheel, sudo)"
arch-chroot "$T" useradd -m -G wheel,video,audio,input,games,rfkill -s /bin/bash "$USER_NAME"
printf '%s:%s\n' "$USER_NAME" "$PASS" | arch-chroot "$T" chpasswd
printf 'root:%s\n' "$PASS" | arch-chroot "$T" chpasswd
install -Dm440 /dev/stdin "$T/etc/sudoers.d/10-wheel" <<<'%wheel ALL=(ALL:ALL) ALL'

ZORP_SERIAL_CONSOLE=$SERIAL zorp-install-target "$T" --disk "$DISK"
sync
umount -R "$T"
log "ZorpOS is installed on $DISK. Remove the live medium and reboot."

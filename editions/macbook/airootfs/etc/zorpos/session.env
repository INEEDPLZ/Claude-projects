# MacBook edition session settings (sourced by zorp-env.sh before the GTK renderer check).
# Haswell/Broadwell Intel graphics (2013-2015 MacBook Pro) has no complete Vulkan driver; GTK's GL
# renderer is the fast path there. Other GPUs and VMs keep ZorpOS's normal detection.
for _d in /sys/class/drm/card[0-9]*/device; do
  [ -e "$_d/driver" ] || continue
  if [ "$(basename "$(readlink -f "$_d/driver")")" = i915 ] && [ -z "$GSK_RENDERER" ]; then
    case "$(cat "$_d/device" 2>/dev/null)" in
      0x04*|0x0a*|0x0c*|0x0d*|0x16*|0x01*) export GSK_RENDERER=ngl ;;   # Ivy Bridge, Haswell, Broadwell
    esac
  fi
done
unset _d

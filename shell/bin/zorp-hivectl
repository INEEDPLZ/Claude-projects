#!/usr/bin/env python3
"""Control the running Hive. Used by Hyprland keybinds.

  zorp-hivectl eye | earthling | jar | starmap | transmission | trail | quit
  zorp-hivectl planet N
  zorp-hivectl set KEY VALUE        (transmissions|cursor_trail|corners on/off, earthling on/off)

If the Hive isn't running, the essential actions fall back to plain Hyprland dispatches,
so keybinds always keep working.
"""
import subprocess
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

APP_ID = "os.zorp.Hive"


def hive_running():
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        r = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                          "NameHasOwner", GLib.Variant("(s)", (APP_ID,)), None, Gio.DBusCallFlags.NONE, 500, None)
        return r.unpack()[0]
    except GLib.Error:
        return False


def activate(action, param=None):
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    path = "/" + APP_ID.replace(".", "/")
    params = [param] if param is not None else []
    bus.call_sync(APP_ID, path, "org.freedesktop.Application", "ActivateAction",
                  GLib.Variant("(sava{sv})", (action, params, {})), None, Gio.DBusCallFlags.NONE, 2000, None)


def fallback(cmd, args):
    hypr = lambda expr: subprocess.call(["hyprctl", "dispatch", expr])  # noqa: E731
    if cmd == "planet":
        return hypr(f"hl.dsp.focus({{ workspace = {int(args[0])} }})")
    if cmd == "jar":
        return hypr('hl.dsp.window.move({ workspace = "special:jar", follow = false })')
    if cmd in ("eye", "starmap"):
        return subprocess.call(["fuzzel"])   # plain launcher when the Hive is down
    if cmd == "earthling":
        import os
        flag = os.path.expanduser("~/.config/zorpos/earthling")
        os.makedirs(os.path.dirname(flag), exist_ok=True)
        if os.path.exists(flag):
            os.remove(flag)
        else:
            open(flag, "w").close()
        return 0
    print(f"zorp-hivectl: the Hive isn't running ({cmd} needs it)", file=sys.stderr)
    return 1


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, args = argv[0], argv[1:]
    if not hive_running():
        return fallback(cmd, args)
    if cmd == "planet":
        activate("planet", GLib.Variant("i", int(args[0])))
    elif cmd == "set":
        activate("set", GLib.Variant("(ss)", (args[0], args[1])))
    else:
        activate(cmd)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/bin/sh
# Start The Hive (Hyprland + the ZorpOS shell). Used by the greeter; also runnable from a text console.
. /usr/lib/zorpos/zorp-env.sh
mkdir -p "$HOME/.config/hypr"
[ -e "$HOME/.config/hypr/hyprland.lua" ] || cp /usr/share/zorpos/hypr/hyprland.user.lua "$HOME/.config/hypr/hyprland.lua"
# keep Hyprland's startup chatter off the console; it goes to a log instead
log="${XDG_STATE_HOME:-$HOME/.local/state}/zorpos/session.log"
mkdir -p "$(dirname "$log")"
exec start-hyprland >"$log" 2>&1
